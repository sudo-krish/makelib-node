{
  "name": "makelib-node",
  "version": "1.1.1",
  "description": "Centralized Make Library & Toolchain for Node.js / TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "makelib": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"test/**/*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit --strict"
  },
  "keywords": [
    "makelib",
    "makefile",
    "toolchain",
    "typescript",
    "eslint",
    "vitest",
    "quality-gates"
  ],
  "author": "Krish <sudo-krish>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "eslint-plugin-security": "^3.0.1",
    "lefthook": "^1.11.2",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.5"
  }
}
