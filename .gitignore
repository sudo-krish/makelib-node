# ==============================================================================
# .gitignore — Standard Node.js / TypeScript Git Ignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.agent/

# Build Outputs
dist/
build/
out/
lib/

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# Cache & Build Info
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System Files
.DS_Store
Thumbs.db

# IDE & Editor Files
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temporary Files
*.tmp
*.temp
tmp/
